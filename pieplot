#!/usr/bin/env bash


usage(){
    echo "
USAGE: $0 [OPTIONS] [DATAFILE]

  Creates a gnuplot script to generate a pie chart.
  Output can be piped directly into gnuplot.
  If no filename is given, data is read from stdin.

  Example:
    $0 data.csv | gnuplot

  Data format:
  The first row is used as title for the pie chart
  Every other row is a data entry with the label in the first column
  and the value in the second column, separated by ;
  Line breaks in labels and title are possible with \n 

  Datafile Example:
  Disk Usage - Data2
  Used:\n 1031 GB;1031567272
  Free:\n 345 GB;345132256

  Options:
    -o, --output <filename>     [default: out.png]
        Sets the filename for the final image.
        The output of this program is still written to stdout.

    -s, --size <size>           [default: 800,600]
        Sets the image size in pixel.

    --fontsize <size>           [default: 18]
        Sets the font size for the slice labels

    --title-fontsize <size>     [default: 24]
        Sets the font size for the slice labels
"
}

colors[0]="#008DD5"
colors[1]="#B9D7E7"
colors[2]="#D33F49"
colors[3]="#FCD581"
colors[4]="#313628"
colors[5]="#A2AEBB"
colors[6]="#53A548"
# create slightly darker versions for the pie wall for a better 3d effect
# only works with hexcodes
for color in ${colors[@]}; do
    if [[ $color =~ ^# ]];then
        r=$((16#${color:1:2} - 10))
        g=$((16#${color:3:2} - 10))
        b=$((16#${color:5:2} - 10))
        r=$((r < 0 ? 0 : r))
        g=$((g < 0 ? 0 : g))
        b=$((b < 0 ? 0 : b))
        colors_shadow+=($(printf "#%02X%02X%02X" $r $g $b))
    else
        colors_shadow+=($color)
    fi
done

output_file="out.png"
size="800,600"
fontsize=18
titlefontsize=24


# handle dashed arguments and remove them from $@
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            usage
            exit 0;;
        -o|--output)
            if [ -z "$2" ]; then
                echo "Error: no output filename given" >&2 ; exit 2
            fi
            output_file="$2"
            shift;shift;;
        -s|--size)
            if [ -z "$2" ]; then
                echo "Error: no size specified" >&2 ; exit 2
            fi
            size="$2"
            shift;shift;;
        --fontsize)
            if [ -z "$2" ]; then
                echo "Error: no size specified" >&2 ; exit 2
            fi
            fontsize="$2"
            shift;shift;;
        --title-fontsize)
            if [ -z "$2" ]; then
                echo "Error: no size specified" >&2 ; exit 2
            fi
            titlefontsize="$2"
            shift;shift;;
        -*)
            echo "Unknown option $1"; exit 1;;
        *)
            POSITIONAL_ARGS+=("$1") # save positional arg
            shift ;;
    esac
done
set -- "${POSITIONAL_ARGS[@]}" # restore positional arguments

# handle positional arguments
if [ -n "$1" ]; then
    input_file="$1"
else
    input_file="/dev/stdin"
fi
echo "reading from $input_file" >&2


# Read the data from file or stdin setting title, labels and values
while read -r line ; do 
    if [ -z "$title" ]; then
        title="$line"
        echo "title: $title" >&2
    else
        label=${line%%;*}
        value=${line#*;}
        if [ -n "$label" ] && [ -n "$value" ]; then
            values+=($value)
            labels+=("$label")
            ((count++))
            ((sum=sum+value))
        fi
    fi
done < "${input_file:-/dev/stdin}"
echo "found $count values with a sum of $sum" >&2

# gnuplot needs the values normalized, the whole pie has the value of 1
for value in ${values[@]};do
    ratios+=( $( echo "$value / $sum" | bc -l ) )
done


# print script for gnuplot
printf 'set terminal pngcairo font "Helvetica,%d" size %s\n' $fontsize "$size"
printf 'set output "%s"\n' $output_file
printf 'set title "%s" font "Helvetica,%d"\n' "$title" $titlefontsize
# a:height B:label distance r:radius s:height over ground
echo "a=0.6; B=1.3; r=1.0; s=0.15"
echo "set view 60, 0; set parametric"
echo "set margin 0"
echo "unset border; unset tics; unset key; unset colorbox"
echo "set ticslevel 0"
echo "set urange [0:1]; set vrange [0:1]"
echo "set xrange [-1:1]; set yrange [-1:1]; set zrange [0:2.5]"
echo "set cbrange [0:2*pi]"
echo "set multiplot"

echo "# draw ground square (currently white because i dont like it)"
echo "set palette model RGB functions 1,1,1"
echo "splot -2+4*u, -2+4*v, 0 w pm3d"

echo "# draw pie shadow"
echo "splot cos(u*2*pi)*v, sin(u*2*pi)*v, 0 w pm3d fillcolor rgb 'dark-grey'"


# draw labels first, otherwise they are invisible (idk why)
echo "# draw labels"
d=${ratios[0]}
for ((j=0;j<count;j++)); do
    printf "set label %d \"%s\" at " $((j+1)) "${labels[j]}"
    printf "cos(%g*pi)*B, -sin(%g*pi)*B, 0.5-sin(%g*pi)*0.8*B centre\n" $d $d $d
    d=$( echo "$d+${values[j]}/$sum + ${values[$((j+1))]}/$sum" | bc -l 2>/dev/null)
done

echo "# draw cylinder wall"
d=1.0
for ((j=count-1;j>=0;j--)); do
    printf "set urange [%s:%g]\n" $(echo "$d-${ratios[j]}" | bc -l) $d
    [ "$d" != "0.0" ] && echo "splot cos(u*2*pi)*r, -sin(u*2*pi)*r, s+v*a w pm3d fillcolor rgb '${colors_shadow[j]}'"
    d=$( echo "$d-${ratios[j]}" | bc -l)
done

echo "# draw cylinder top"
d=0.0;
for ((j=count-1;j>=0;j--)); do
    printf "set urange [%s:%g]\n" $(echo "$d-${ratios[j]}" | bc -l) $d
    echo "splot cos(u*2*pi)*r*v, -sin(u*2*pi)*r*v, s+a w pm3d fillcolor rgb '${colors[j]}'"
    d=$( echo "$d-${ratios[j]}" | bc -l)
done


